# Make variables only: Kbuild files test these, but they are not C defines
# (no autoconf entry), exactly as the fogos 6.1 build passed them to the
# Motorola modules (tools/build-vendor.sh peripherals).
CONFIG_INPUT_TOUCHSCREEN_MMI=y
CONFIG_ILITEK_ESD=y
CONFIG_INPUT_MISC_FPC1020_SAVE_TO_CLASS_DEVICE=y

# The Motorola vendor_dlkm drivers (motorola/Kbuild); off until ported.
# CONFIG_FOGOS_MOTO_DLKM=y
