# SPDX-License-Identifier: GPL-2.0-only
# Make variables only: Kbuild files test these, but they are not C defines
# (no autoconf entry), exactly as the fogos 6.1 build passed them to the
# Motorola modules (tools/build-vendor.sh peripherals).
CONFIG_INPUT_TOUCHSCREEN_MMI=y
CONFIG_ILITEK_ESD=y
# Halcyon PowerHAL writes 0x30/0x31 to touchscreen/primary/gesture.
CONFIG_BOARD_USES_DOUBLE_TAP_CTRL=y
CONFIG_INPUT_ILI_ENABLE_DOUBLE_TAP=y
CONFIG_INPUT_CHIPONE_0FLASH_MMI_ENABLE_DOUBLE_TAP=y
CONFIG_INPUT_MISC_FPC1020_SAVE_TO_CLASS_DEVICE=y

# The Motorola vendor_dlkm drivers (motorola/Kbuild).
CONFIG_FOGOS_MOTO_DLKM=y

# Display (techpack/display): the Blair feature set (config/gki_blairdisp.conf)
# and the module, as the 6.1 build selected them.
CONFIG_ARCH_BLAIR=y
CONFIG_DRM_MSM=m

# Retain TDDI power for gestures through the QCOM panel notifier.
CONFIG_INPUT_ILI_SET_TOUCH_STATE=y
CONFIG_INPUT_CHIPONE_0FLASH_MMI_NOTIFY_TOUCH_STATE=y
