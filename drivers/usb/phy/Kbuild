# Objects as linked by the fogos 6.1 build.

# This directory first, then the kernel subsystem's private headers,
# as for an in-tree build.
ccflags-y += -I$(src) -I$(srctree)/drivers/usb/phy

obj-$(CONFIG_MSM_HSUSB_PHY) += phy-msm-snps-hs.o
obj-$(CONFIG_USB_MSM_SSPHY_QMP) += phy-msm-ssusb-qmp.o

obj-$(CONFIG_MSM_QUSB_PHY) += phy-msm-qusb.o
obj-$(CONFIG_MSM_QUSB_PHY) += phy-msm-qusb-v2.o
obj-$(CONFIG_USB_QCOM_EMU_PHY) += phy-qcom-emu.o
