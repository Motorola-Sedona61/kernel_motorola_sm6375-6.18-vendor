# Objects as linked by the fogos 6.1 build.

# This directory first, then the kernel subsystem's private headers,
# as for an in-tree build.
ccflags-y += -I$(src) -I$(srctree)/drivers/thermal/qcom
# The Qualcomm 6.12 sources include thermal core headers from the kernel
# root and from drivers/thermal.
ccflags-y += -I$(srctree) -I$(srctree)/drivers/thermal

obj-$(CONFIG_THERMAL_TSENS_LEGACY) += msm-tsens-driver.o
msm-tsens-driver-y := msm-tsens.o tsens2xxx.o tsens-dbg.o
obj-$(CONFIG_QCOM_SPMI_ADC_TM5) += qcom-spmi-adc-tm5.o
obj-$(CONFIG_QCOM_SPMI_TEMP_ALARM) += qcom-spmi-temp-alarm.o
