# Objects as linked by the fogos 6.1 build.

# This directory first, then the kernel subsystem's private headers,
# as for an in-tree build.
ccflags-y += -I$(src) -I$(srctree)/drivers/ufs/host
# Core private headers are included from the kernel root.
ccflags-y += -I$(srctree)

obj-$(CONFIG_SCSI_UFS_QCOM) += ufs_qcom.o
ufs_qcom-y := ufs-qcom.o ufs-qcom-ice.o
obj-$(CONFIG_SCSI_UFS_CRYPTO_QTI) += ufshcd-crypto-qti.o
